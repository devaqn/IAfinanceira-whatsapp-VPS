exports/
backups/
data/backups/
*.backup
*.bkp

# ==================== 🎨 ASSETS DESNECESSÁRIOS ====================
# Assets temporários
uploads/
temp-images/
cache/

# ==================== 🔄 ARQUIVOS DE MERGE ====================
